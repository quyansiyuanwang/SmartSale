# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*
.env.demo.local
.env.local
/supabase/functions/.env
/goal/local/
/supabase/.temp/
/supabase/.branches/

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# vite-plugin-pwa dev cache
/dev-dist

# Local workspace for things that are not part of this project: the external
# arena demo server bundle, its generated secrets, probe scripts and notes.
# Everything under /.tmp/ stays untracked; see .tmp/README.md.
/.tmp/
