# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*
.env.demo.local
.env.local
/supabase/functions/.env
/goal/local/
/supabase/.temp/
/supabase/.branches/

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# vite-plugin-pwa dev cache
/dev-dist

# Local arena deployment workspace: an external host used for demos, not part of
# this project's implementation. Probe scripts, generated secrets, deployment
# notes and build env stay untracked.
/.deploy/
/deploy-arena/
/.env.arena
/docs/11-arena-deployment.md
