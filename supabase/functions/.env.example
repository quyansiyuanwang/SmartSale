# Local Supabase Edge Function secrets. Copy to .env (ignored by Git).
# Never put provider keys in root .env.local or VITE_* variables.
DEEPSEEK_API_KEY=replace-with-your-chat-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEFAULT_CHAT_MODEL=deepseek-chat

# Required for knowledge ingestion and semantic search.
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Optional OpenAI-compatible provider support.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost
