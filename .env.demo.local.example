# Optional real AI for `npm run demo`. This file is read by the local Vite server only.
# Copy to .env.demo.local and never use a VITE_ prefix for the provider key.
VITE_DEMO_AI_ENABLED=true
DEMO_AI_BASE_URL=https://api.deepseek.com/v1
DEMO_AI_API_KEY=replace-with-your-key
DEMO_AI_MODEL=deepseek-chat
